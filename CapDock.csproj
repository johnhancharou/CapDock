<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CapDock</AssemblyName>
    <RootNamespace>CapDock</RootNamespace>
    <Product>CapDock</Product>
    <ApplicationIcon>CapDock.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Та же иконка внутри exe как ресурс: трей и окна берут из неё нужный размер -->
    <EmbeddedResource Include="CapDock.ico" LogicalName="CapDock.ico" />
  </ItemGroup>
</Project>
